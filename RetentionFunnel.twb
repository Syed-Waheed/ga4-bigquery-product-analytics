      <column caption='Total Sessions' datatype='integer' name='[Calculation_5093540159119362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([ga_session_id])' />
      </column>
      <column caption='Total Purchases' datatype='integer' name='[Calculation_5093540159205379]' role='measure' type='quantitative'>
