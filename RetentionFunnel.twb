        <calculation class='tableau' formula='SUM([added_payment]) / SUM([started_checkout])' />
      </column>
      <column caption='Payment to Purchase Rate' datatype='real' default-format='p0.00%' name='[Calculation_5093540162531345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([purchased]) / SUM([added_payment])' />
      </column>
      <column caption='Acquisition Channel' datatype='string' name='[Calculation_5093540164763666]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[acquisition_source] + &quot; / &quot; + [acquisition_medium]' />
      </column>
      <column caption='Acquisition Purchase Rate' datatype='real' name='[Calculation_5093540164870163]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([purchased]) / COUNT([ga_session_id])' />
      </column>
      <column caption='Acquisition Channel Clean' datatype='string' name='[Calculation_5093540168462357]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [acquisition_source]&#10;&#10;WHEN &quot;(direct)&quot; THEN&#10;    &quot;Direct&quot;&#10;&#10;WHEN &quot;google&quot; THEN&#10;    CASE [acquisition_medium]&#10;        WHEN &quot;organic&quot; THEN &quot;Google Organic&quot;&#10;        WHEN &quot;cpc&quot; THEN &quot;Google Paid&quot;&#10;        WHEN &quot;Other&quot; THEN &quot;Google / Other&quot;&#10;        WHEN &quot;&lt;Other&gt;&quot; THEN &quot;Google / Other&quot;&#10;        ELSE &quot;Google / &quot; + [acquisition_medium]&#10;    END&#10;&#10;WHEN &quot;shop.googlemerchandisestore.com&quot; THEN&#10;    &quot;Google Store Referral&quot;&#10;&#10;WHEN &quot;Other&quot; THEN&#10;    CASE [acquisition_medium]&#10;        WHEN &quot;(data deleted)&quot; THEN &quot;Other / Unknown&quot;&#10;        WHEN &quot;&lt;Other&gt;&quot; THEN &quot;Other / Other&quot;&#10;        WHEN &quot;Other&quot; THEN &quot;Other / Other&quot;&#10;        WHEN &quot;organic&quot; THEN &quot;Other Organic&quot;&#10;        WHEN &quot;referral&quot; THEN &quot;Other Referral&quot;&#10;        WHEN &quot;cpc&quot; THEN &quot;Other Paid&quot;&#10;        ELSE &quot;Other / &quot; + [acquisition_medium]&#10;    END&#10;&#10;WHEN &quot;&lt;Other&gt;&quot; THEN&#10;    CASE [acquisition_medium]&#10;        WHEN &quot;(data deleted)&quot; THEN &quot;Other / Unknown&quot;&#10;        WHEN &quot;&lt;Other&gt;&quot; THEN &quot;Other / Other&quot;&#10;        WHEN &quot;organic&quot; THEN &quot;Other Organic&quot;&#10;        WHEN &quot;referral&quot; THEN &quot;Other Referral&quot;&#10;        WHEN &quot;cpc&quot; THEN &quot;Other Paid&quot;&#10;        ELSE &quot;Other / &quot; + [acquisition_medium]&#10;    END&#10;&#10;WHEN &quot;(data deleted)&quot; THEN&#10;    CASE [acquisition_medium]&#10;        WHEN &quot;(data deleted)&quot; THEN &quot;Data Deleted / Data Deleted&quot;&#10;        WHEN &quot;referral&quot; THEN &quot;Data Deleted / Referral&quot;&#10;        ELSE &quot;Data Deleted / &quot; + [acquisition_medium]&#10;    END&#10;&#10;ELSE&#10;    [acquisition_source] + &quot; / &quot; + [acquisition_medium]&#10;&#10;END' />
      </column>
      <column caption='Lifecycle Sessions' datatype='integer' name='[Calculation_5093540169936918]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([ga_session_id])' />
      </column>
      <column caption='Lifecycle Purchases' datatype='integer' name='[Calculation_5093540169990167]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([purchased])' />
      </column>
      <column caption='Lifecycle Purchase Rate' datatype='real' default-format='p0.00%' name='[Calculation_5093540170043416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([purchased]) / COUNT([ga_session_id])' />
      </column>
      <column caption='Purchase Share' datatype='real' name='[Calculation_5093540170100761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([purchased]) / SUM({ FIXED : SUM([purchased]) })' />
      </column>
      <column caption='Overall Purchase Rate' datatype='real' default-format='p0.00%' name='[Calculation_5093540171112477]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM([purchased]) } / { FIXED : COUNT([ga_session_id]) }' />
      </column>
      <column caption='First Session Date' datatype='date' name='[Calculation_5093540175884318]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [user_pseudo_id] :&#10;    MIN([session_date])&#10;}' />
      </column>
      <column caption='Cohort Week' datatype='datetime' name='[Calculation_5093540175970335]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [Calculation_5093540175884318], &apos;Monday&apos;)' />
      </column>
      <column caption='Activity Week' datatype='datetime' name='[Calculation_5093540176117793]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;week&apos;, [session_date], &apos;Monday&apos;)' />
      </column>
      <column caption='Weeks Since Cohort' datatype='integer' name='[Calculation_5093540176171042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#10;    &apos;week&apos;,&#10;    DATETRUNC(&apos;week&apos;, [Calculation_5093540175884318], &apos;Monday&apos;),&#10;    DATETRUNC(&apos;week&apos;, [session_date], &apos;Monday&apos;)&#10;)' />
      </column>
      <column caption='Cohort Size' datatype='integer' name='[Calculation_5093540176236579]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_5093540175970335] :&#10;    COUNTD([user_pseudo_id])&#10;}' />
      </column>
      <column caption='Retention Rate' datatype='real' name='[Calculation_5093540176298020]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([user_pseudo_id]) / MIN([Calculation_5093540176236579])' />
      </column>
