      </column>
      <column caption='Purchase Rate' datatype='real' default-format='p0.00%' name='[Calculation_5093540159266820]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([purchased]) / COUNT([ga_session_id])' />
      </column>
      <column caption='Revenue' datatype='real' default-format='c&quot;$&quot;#,##0;-&quot;$&quot;#,##0' name='[Calculation_5093540159365125]' role='measure' type='quantitative'>
